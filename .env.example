# FSD-XAI Forensic App — environment configuration
#
# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is gitignored — never commit real credentials.

# ── AWS S3 ────────────────────────────────────────────────────────────
# Access key + secret from the IAM user created for this app.
# See docs on setup: an IAM user named `fsd-xai-app-user` with S3 access.
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY_HERE

# AWS region the bucket lives in (Mumbai for South Asia).
AWS_REGION=ap-south-1

# S3 bucket name (globally unique, chosen at creation time).
S3_BUCKET_NAME=fsd-xai-forensics-pasindu

# ── Optional S3-compatible provider (for example OCI Object Storage) ───
# Leave these blank for AWS S3. OCI uses a customer-secret access-key pair
# in the AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY fields above, plus:
# S3_ENDPOINT_URL=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# AWS_REGION=<your-oci-region, e.g. ap-mumbai-1>
# S3_ADDRESSING_STYLE=path
# S3_SERVER_SIDE_ENCRYPTION=none

# ── Local database ────────────────────────────────────────────────────
# SQLite file path. Kept local — audit trail stays on the examiner workstation.
DATABASE_PATH=./fsd_xai.db

# ── App behaviour ─────────────────────────────────────────────────────
# When set to "1", the Streamlit app uses the real PyTorch model.
# When unset or "0", the app runs against the mock model (procedural placeholder).
FSDXAI_REAL_MODEL=1
FSDXAI_SHAP_BACKGROUND_PREFIX=shap-background/v1

# ── Initial super-admin bootstrap ─────────────────────────────────────
# When the users table is empty on first startup, one super admin is
# created from these values. Change the password immediately after login.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-on-first-login
INITIAL_ADMIN_FULL_NAME=Super Administrator

# ── Report email (optional) ────────────────────────────────────────────
# Create a dedicated mailbox or SMTP account. The sender must be accepted
# by that account. Keep the real password in .env/.env.supabase or hosting
# secrets, never in this example or the Git repository.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=reports@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_CREDENTIAL
SMTP_FROM_EMAIL=reports@example.com
